{
  "name": "tourab-crypto-ai",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled=true --coverage.reporter=text --coverage.reporter=json-summary",
    "mission-control:start": "concurrently -k -n server,ui \"npm run mission-control:server\" \"npm run mission-control:dev\"",
    "mission-control:dev": "npm run dev --workspace @tourab/mission-control",
    "mission-control:build": "npm run build --workspace @tourab/mission-control",
    "mission-control:typecheck": "npm run typecheck --workspace @tourab/mission-control",
    "mission-control:test": "npm run test --workspace @tourab/mission-control",
    "mission-control:test:coverage": "npm run test --workspace @tourab/mission-control -- --coverage.enabled=true --coverage.reporter=text --coverage.reporter=json-summary",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run mission-control:test",
    "mission-control:server": "tsx apps/dashboard/src/mission-control-server.ts",
    "gatekeeper:cli": "tsx apps/dashboard/src/cli.ts",
    "okx:demo:execute": "tsx apps/dashboard/src/okx-demo-execute-cli.ts",
    "okx:demo:health": "tsx apps/dashboard/src/okx-demo-health-cli.ts",
    "okx:demo:diag": "tsx apps/dashboard/src/okx-demo-diagnostic-cli.ts",
    "okx:demo:build-proposal": "tsx apps/dashboard/src/okx-proposal-helper-cli.ts",
    "okx:demo:orders": "tsx apps/dashboard/src/okx-demo-orders-cli.ts",
    "okx:demo:reconcile": "tsx apps/dashboard/src/okx-demo-reconcile-cli.ts",
    "okx:demo:cancel": "tsx apps/dashboard/src/okx-demo-cancel-cli.ts",
    "okx:demo:auto-loop": "tsx apps/dashboard/src/okx-demo-auto-loop-cli.ts",
    "soak:m5": "tsx scripts/m5-soak.ts",
    "evidence:m5": "tsx scripts/m5-evidence-rollup.ts",
    "acceptance:m6": "tsx scripts/m6-acceptance-walkthrough.ts",
    "snapshot:m7": "tsx scripts/m7-dataset-snapshot.ts",
    "retrain:m7": "tsx scripts/m7-retrain-offline.ts",
    "walkforward:m7": "tsx scripts/m7-walk-forward.ts",
    "gate:m7": "tsx scripts/m7-gate-promotion.ts",
    "rollback:m7": "tsx scripts/m7-rollback-drill.ts"
  },
  "dependencies": {
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "fast-check": "^3.23.2",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript-eslint": "^8.41.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
