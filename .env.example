# OKX demo credentials
OKX_TRADING_MODE=demo
OKX_DEMO_API_KEY=your_demo_api_key
OKX_DEMO_API_SECRET=your_demo_api_secret
OKX_DEMO_PASSPHRASE=your_demo_passphrase
# Optional alias supported by adapter:
# OKX_DEMO_API_PASSPHRASE=your_demo_passphrase
OKX_DEMO_BASE_URL=https://www.okx.com
OKX_DEMO_SIMULATED_TRADING=1

# Human approval gate for execution CLI
# 1/true/on/yes -> require token before submit
# 0/false/off/no -> bypass token requirement
TOURAB_HUMAN_APPROVAL_ENABLED=1
TOURAB_HUMAN_APPROVAL_TOKEN=replace_with_long_random_string

# OKX live credentials
OKX_LIVE_API_KEY=your_live_api_key
OKX_LIVE_API_SECRET=your_live_api_secret
OKX_LIVE_PASSPHRASE=your_live_passphrase
OKX_LIVE_BASE_URL=https://www.okx.com
OKX_LIVE_SIMULATED_TRADING=0

# Dashboard settings
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_SESSION_SECRET=replace_me
DASHBOARD_LOG_LEVEL=info

# Research engine settings
RESEARCH_ENGINE_MODE=local
RESEARCH_PYTHON_PATH=python
RESEARCH_DATA_DIR=./data
RESEARCH_CACHE_DIR=./cache
